<?php
// get_credentials.php

require_once 'vendor/autoload.php';

use Twilio\Rest\Client;

echo "========================================\n";
echo "  🔐 RÉCUPÉRATION DES IDENTIFIANTS TWILIO\n";
echo "========================================\n\n";

// Vos identifiants de connexion Twilio
$username = 'votre_email@example.com';  // Votre email Twilio
$password = 'votre_mot_de_passe';        // Votre mot de passe Twilio

// URL de l'API Twilio pour récupérer le compte
$url = 'https://api.twilio.com/2010-04-01/Accounts.json';

// Envoyer la requête
$ch = curl_init();
curl_setopt($ch, CURLOPT_URL, $url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_USERPWD, "$username:$password");
curl_setopt($ch, CURLOPT_HTTPHEADER, ['Accept: application/json']);

$response = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

if ($httpCode == 200) {
    $data = json_decode($response, true);
    
    if (!empty($data['accounts'])) {
        foreach ($data['accounts'] as $account) {
            echo "✅ Compte trouvé !\n";
            echo "📋 Account SID : " . $account['sid'] . "\n";
            echo "📋 Account Name : " . $account['friendly_name'] . "\n";
            echo "📋 Statut : " . $account['status'] . "\n";
            echo "📋 Type : " . $account['type'] . "\n";
            echo "\n";
            
            // Le Auth Token n'est pas retourné par cette API pour des raisons de sécurité
            // Vous devez le récupérer depuis la console
            echo "🔑 Auth Token : À récupérer depuis la console Twilio\n";
            echo "   (Connectez-vous sur https://www.twilio.com/console)\n";
        }
    }
} else {
    echo "❌ Erreur : Impossible de se connecter ($httpCode)\n";
    echo "💡 Vérifiez vos identifiants (email et mot de passe)\n";
}